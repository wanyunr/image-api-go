# image-api-go 配置模板
# 复制为 config.yaml 后按需修改：cp config.yaml.example config.yaml

server:
  host: "0.0.0.0"
  port: 28085
  base_path: "/"
  # 图片 API 的 URL 池文件（相对当前工作目录）
urls:
  portrait: "urls/portrait.txt"
  landscape: "urls/landscape.txt"
auth:
  enabled: false
  tokens:
    - "your_secret_token"   # 改成你自己的 token
rate_limit:
  enabled: false
  per_minute: 30
  per_hour: 120
  per_day: 300
referer:
  enabled: false
  allow_empty: true
  whitelist:
    - "example.com"
    - "*.example.com"
